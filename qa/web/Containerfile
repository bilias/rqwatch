# Web server image for the qa/ harnesses (start_web_container in qa/lib.sh):
# httpd and PHP-FPM from Remi's repository on Rocky Linux 9, installed as
# docs/INSTALL.md does. The code is not in the image: start_web_container
# mounts the copy at /var/www/html/rqwatch and runs qa/web/web-start.sh from
# it. httpd's and PHP-FPM's own logs go to the container's output (podman logs).
ARG BASE_IMAGE=quay.io/rockylinux/rockylinux:9
FROM ${BASE_IMAGE}
ARG PHP_STREAM=remi-8.4
# start_web_container maps the invoking user to this uid (--userns=keep-id)
ARG RQWATCH_UID=1000
# glibc-gconv-extra: iconv's character sets beyond the basic ones (KOI8-R,
# Windows-125x, ...), which decoding 8-bit mail headers needs; the base
# image lacks it
RUN dnf -y install dnf-plugins-core epel-release \
	&& dnf config-manager --set-enabled crb \
	&& dnf -y install https://rpms.remirepo.net/enterprise/remi-release-9.rpm \
	&& dnf -y module enable "php:${PHP_STREAM}" \
	&& dnf -y install httpd php-fpm php-cli php-mysqlnd php-pdo \
		php-pecl-mailparse php-mbstring php-xml \
		php-ldap php-pecl-redis6 php-gmp glibc-gconv-extra \
	&& dnf clean all \
	&& groupadd -g "${RQWATCH_UID}" rqwatch \
	&& useradd -u "${RQWATCH_UID}" -g rqwatch -M -d /var/www/html/rqwatch -s /sbin/nologin rqwatch \
	&& ln -sf /dev/stderr /var/log/httpd/error_log \
	&& ln -sf /dev/stdout /var/log/httpd/access_log \
	&& ln -sf /dev/stderr /var/log/php-fpm/error.log
# start_web_container passes the date as UPDATE_STAMP (or the time, with
# QA_WEB_UPDATE=1), so this layer, and only this one, is rebuilt once a day
ARG UPDATE_STAMP=none
RUN echo "dnf update: ${UPDATE_STAMP}" && dnf -y update && dnf clean all
