<?xml version="1.0" encoding="UTF-8"?>
<!-- Run through qa/scoping-tests.sh, which provides the database and web server -->
<phpunit bootstrap="../vendor/autoload.php"
	colors="true"
	testdox="true"
	failOnWarning="true"
	failOnRisky="true"
	executionOrder="default">
	<testsuites>
		<testsuite name="scoping">
			<directory>../tests/Scoping</directory>
		</testsuite>
	</testsuites>
</phpunit>
