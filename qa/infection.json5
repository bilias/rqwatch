// Infection on the unit suite (qa/infection.sh, which also sets the report
// paths); paths are relative to this file (qa/). The suite is
// qa/infection/phpunit.xml: Infection wants a phpunit.xml in a directory of
// its own, so it cannot use qa/phpunit-unit.xml.
{
	"$schema": "../vendor/infection/infection/resources/schema.json",
	"source": {
		"directories": ["../app"]
	},
	"phpUnit": {
		"configDir": "infection"
	},
	"mutators": {
		"@default": true,
		// Reviewed escapes that no test can tell from the original, each by
		// Class::method::line. When a line moves, its mutant is reported again
		// for review.
		"ArrayOneItem": {
			// stats come only from a real controller; Integration's Smoke/RspamdStatTest
			"ignore": ["App\\Controllers\\Controller::getRspamdStat::310"]
		},
		"ArrayItemRemoval": {
			"ignore": [
				// Symfony's HttpClient verifies the peer by default too
				"App\\Services\\ApiClient::__construct::27",
				// 'required' => true is the default
				"App\\Forms\\CustomMapConfigForm::buildForm::41",
				"App\\Forms\\CustomMapConfigForm::buildForm::68",
				"App\\Forms\\CustomMapConfigForm::buildForm::87",
				"App\\Forms\\CustomMapConfigForm::buildForm::106",
				"App\\Forms\\LoginForm::buildForm::38",
				"App\\Forms\\LoginForm::buildForm::58",
				"App\\Forms\\MailAliasForm::buildForm::36",
				"App\\Forms\\MailAliasForm::buildForm::55",
				"App\\Forms\\QidForm::buildForm::39",
				"App\\Forms\\UserForm::buildForm::45",
				"App\\Forms\\UserForm::buildForm::65",
				"App\\Forms\\FuzzySearchForm::buildForm::41",
				"App\\Forms\\MailAliasSearchForm::buildForm::40",
				"App\\Forms\\MapSearchForm::buildForm::38",
				"App\\Forms\\UserSearchForm::buildForm::40",
				"App\\Forms\\SearchForm::buildForm::43",
				"App\\Forms\\SearchForm::buildForm::52",
				// 'mapped' => true is the default
				"App\\Forms\\MapSearchForm::buildForm::49",
				"App\\Forms\\MapSearchForm::buildForm::52"
			]
		},
		"BitwiseOr": {
			// a word run holds only letters, marks and format chars: valid UTF-8, no quotes
			"ignore": [
				"App\\Twig\\RqwatchExtension::markHomoglyphs::216",
				"App\\Twig\\RqwatchExtension::markHomoglyphs::218"
			]
		},
		"CastFloat": {
			"ignore": [
				// a float return type converts an int anyway, strict_types or not
				"App\\Configuration\\Config::getFloat::76",
				// a SUM() string divides as a number without the cast
				"App\\Utils\\Helper::formatSizeUnits::500",
				"App\\Utils\\Helper::formatSizeUnits::502",
				"App\\Utils\\Helper::formatSizeUnits::504",
				// an int or a SUM() string divides by a float as a float anyway
				"App\\Charts\\ChartBuilder::createReportsDayChart::241"
			]
		},
		"CastInt": {
			"ignore": [
				// numeric text compares as its number; the int is first needed past the database
				"App\\Api\\FuzzyMailApi::handle::55",
				"App\\Api\\FuzzyMailApi::handle::58",
				// a prefix of digits compares and subtracts as a number either way
				"App\\Inventory\\MapInventory::validateIpOrCidr::486",
				"App\\Inventory\\MapInventory::validateIpOrCidr::498",
				// '8' and (int) '8' print the same; the prefix was checked to be digits
				"App\\Inventory\\MapInventory::validateIpOrCidr::505",
				// preg_match_all() false is not > 0 either
				"App\\Utils\\Helper::extract_mail_relays::1132",
				// a digits-only string compares with 0 as a number
				"App\\Utils\\Helper::check_id_qid::805"
			]
		},
		"CastString": {
			"ignore": [
				// a form field is text, and an upload PHP stored is readable
				"App\\Api\\MetadataImporterMultipartApi::handle::225",
				"App\\Api\\MetadataImporterMultipartApi::handle::258",
				// an int . 'B' is the same string
				"App\\Utils\\Helper::formatSizeUnits::506",
				// json_encode() of a decoded value does not fail
				"App\\Utils\\Helper::log_to_files::698",
				// preg_replace() with this ASCII pattern does not fail
				"App\\Utils\\Helper::oneLine::873",
				// json_encode() with JSON_PARTIAL_OUTPUT_ON_ERROR does not fail
				"App\\Services\\FuzzyService::flags::112",
				// inet_ntop() of a packed address does not fail
				"App\\Inventory\\MapInventory::validateIpOrCidr::505",
				// preg_replace() with this ASCII pattern does not fail
				"App\\Models\\MailLog::logUnparsableMimeFrom::275",
				// a null qid reaches a string parameter only past the database lookup
				"App\\Services\\FuzzyService::learnLocal::315"
			]
		},
		"Concat": {
			// the default log file is the install's logs/: a test would write outside its temp dir
			"ignore": ["App\\Core\\Logging\\LoggerFactory::createFileLogger::38"]
		},
		"ConcatOperandRemoval": {
			// the same default log file
			"ignore": ["App\\Core\\Logging\\LoggerFactory::createFileLogger::38"]
		},
		"Coalesce": {
			"ignore": [
				// the password goes only to a real controller; Integration's Smoke/RspamdStatTest
				"App\\Controllers\\Controller::getRspamdStat::257",
				// checkSet() and checkInt() report the same for a missing or non-string value
				"App\\Configuration\\EnvValidator::errors::96",
				// mailparse always sets is_group; a group's ":;" is no address anyway
				"App\\Utils\\Helper::getMailFromMime::1385",
				// the builders' charts always have datasets; without, both fail (the
				// swap only adds an undefined-key warning, which still passes)
				"App\\Charts\\ChartBuilder::addStoredRatio::307",
				// the picker always has its hidden model field
				"App\\Forms\\MapSelectForm::check_form_show::101",
				// without data, or a username in it, the swap only adds an
				// undefined-key warning, which still passes
				"App\\Forms\\UserDeleteForm::buildForm::34",
				"App\\Forms\\UserDeleteForm::buildForm::36"
			]
		},
		"DecrementInteger": {
			"ignore": [
				// -1 is refused as 0 is, and the message names neither
				"App\\Api\\FuzzyMailApi::handle::53",
				"App\\Api\\FuzzyMailApi::handle::55",
				"App\\Api\\FuzzyMailApi::handle::58",
				// an unset spool limit or TTL is unusable as -1 as it is as 0
				"App\\Services\\Import\\MailLogSpool::push::199",
				"App\\Services\\Import\\MailLogSpool::push::200",
				// no attachments leave the list empty either way
				"App\\Inventory\\MailObject::setAttached::123",
				// a missing seen time expires the handle either way
				"App\\Controllers\\QuarantineController::sessionToken::323",
				// an empty password is refused by NotBlank before Length
				"App\\Forms\\LoginForm::buildForm::69",
				// an empty search, the same
				"App\\Forms\\FuzzySearchForm::buildForm::51",
				"App\\Forms\\UserSearchForm::buildForm::50",
				"App\\Forms\\SearchForm::buildForm::66",
				// 7 zero bytes differ from 8 only in the reserved ::/56
				"App\\Core\\Auth\\LoginThrottle::keyFor::290",
				// a shift by 9 masks the byte to 0, as a shift by 8 does
				"App\\Inventory\\MapInventory::validateIpOrCidr::498",
				// any total not above 0 is no total: no ratio
				"App\\Charts\\ChartBuilder::createQuarantineChart::98",
				"App\\Charts\\ChartBuilder::createQuarantinePerMonthChart::154",
				// a byte either side of no size rounds to 0.0 MB (-0.0 === 0.0)
				"App\\Charts\\ChartBuilder::createReportsDayChart::241",
				// a byte more or less in a MB is a millionth: no %.2f figure shows it
				"App\\Utils\\Helper::getRuntime::445",
				"App\\Utils\\Helper::getRuntime::446"
			]
		},
		"FalseValue": {
			"ignore": [
				// mailparse always sets is_group
				"App\\Utils\\Helper::getMailFromMime::1385",
				// inet_pton() of an address FILTER_VALIDATE_IP accepted does not fail
				"App\\Inventory\\MapInventory::canonicalIpOrCidr::463",
				// an answer found is cached for the full TTL whether or not it is called transient
				"App\\Utils\\Helper::lookupPtr::1586",
				"App\\Utils\\Helper::lookupA::1643",
				// SafeLineFormatter replaces line breaks whatever allowInlineLineBreaks says
				"App\\Core\\Logging\\LoggerFactory::createFileLogger::51",
				"App\\Core\\Logging\\LoggerFactory::createSyslogLogger::92"
			]
		},
		"GreaterThan": {
			"ignore": [
				// no attachments leave the list empty either way
				"App\\Inventory\\MailObject::setAttached::123",
				// custom maps come from the database; Integration covers them
				"App\\Inventory\\MapInventory::getMapConfigs::243",
				// no addresses matched leaves the loop empty either way
				"App\\Utils\\Helper::extract_mail_relays::1132",
				// one second at the idle limit; a test would race the clock
				"App\\Controllers\\QuarantineController::sessionToken::327",
				"App\\Core\\SessionManager::checkSessionExpired::182",
				// 1 byte is "1B" in either branch
				"App\\Utils\\Helper::formatSizeUnits::505"
			]
		},
		"GreaterThanNegotiation": {
			// custom maps come from the database; Integration covers them
			"ignore": ["App\\Inventory\\MapInventory::getMapConfigs::243"]
		},
		"IncrementInteger": {
			"ignore": [
				"App\\Controllers\\QuarantineController::sessionToken::323",
				// 9 zero bytes differ from 8 only in the reserved ::/64
				"App\\Core\\Auth\\LoginThrottle::keyFor::290",
				// explode()'s limit: only [0] is read
				"App\\Utils\\Helper::fuzzySymbolClass::202",
				"App\\Utils\\Helper::get_symbol_class::322",
				// only frame [1] is read
				"App\\Utils\\Helper::debugException::1493",
				// array_pad() to 3 leaves the two values destructured unchanged; the line's
				// other mutant, explode() limit 3, is killed by the 'a second slash' cases
				"App\\Inventory\\MapInventory::canonicalIpOrCidr::457",
				"App\\Inventory\\MapInventory::validateIpOrCidr::481",
				// a byte either side of no size rounds to 0.0 MB
				"App\\Charts\\ChartBuilder::createReportsDayChart::241",
				// a byte more or less in a MB is a millionth: no %.2f figure shows it
				"App\\Utils\\Helper::getRuntime::445",
				"App\\Utils\\Helper::getRuntime::446"
			]
		},
		"LogicalAnd": {
			"ignore": [
				// the router attaches the session before any middleware runs
				"App\\Core\\Middleware\\AuthMiddleware::handle::46",
				// null and '' fall through the switch to the same "clean"
				"App\\Utils\\Helper::get_row_class::372",
				// every mailparse entry is an array
				"App\\Utils\\Helper::getMailFromMime::1385"
			]
		},
		"LogicalNot": {
			// without a database warmCache() returns at once; Integration covers the warm-up
			"ignore": [
				"App\\Core\\Database\\MigrationStatus::getMigrationState::154",
				"App\\Core\\Database\\MigrationStatus::warmCache::69"
			]
		},
		"LogicalOr": {
			"ignore": [
				// php-ip's isPrivate() or isReserved() already covers loopback and link-local
				"App\\Utils\\Helper::isLocalOrReservedIp::1230",
				// valid UTF-8 comes out of toUtf8() unchanged
				"App\\Utils\\Helper::normalizeToUtf8::1460",
				// authenticate() returns true or answers and exits: either way the
				// condition is false, || or &&
				"App\\Api\\RqwatchApi::checkAuth::119"
			]
		},
		"LogicalOrAllSubExprNegation": {
			"ignore": [
				// a code is an int or a string, never both, so the negation is always true, as the original is
				"App\\Services\\Import\\MailLogWriter::describe::77",
				// a usable password goes on to the database; Integration's UserAdminTest adds users
				"App\\Services\\UserService::userAdd::294"
			]
		},
		"MethodCallRemoval": {
			"ignore": [
				// a new Response is 200, and without prepare() its charset is not sent
				"App\\Api\\MetadataImporterMultipartApi::handle::580",
				"App\\Api\\MetadataImporterMultipartApi::handle::582",
				// without a database warmCache() returns at once; Integration covers the warm-up
				"App\\Core\\Database\\MigrationStatus::getMigrationState::155",
				// with the API on it does nothing; off, it answers and exits (Integration's ApiAccessTest)
				"App\\Api\\RqwatchApi::__construct::47"
			]
		},
		"NotIdentical": {
			// the test seams: negated, the unit tests' answers are sent for real and exit
			"ignore": [
				"App\\Core\\Auth\\BasicAuth::doBasicAuth::85",
				"App\\Api\\RqwatchApi::respond::155"
			]
		},
		"PregMatchRemoveCaret": {
			"ignore": [
				// the Y-m-d round trip refuses anything else
				"App\\Utils\\Helper::check_date::651",
				// no MimeCharset alias has these names past its start; unknown names become us-ascii
				"App\\Utils\\Helper::mailCharset::1420"
			]
		},
		"PregMatchRemoveDollar": {
			"ignore": [
				// the Y-m-d round trip refuses anything else
				"App\\Utils\\Helper::check_date::651",
				// FILTER_VALIDATE_INT refuses trailing text anyway
				"App\\Core\\Database\\Row::toInt::89"
			]
		},
		"PregMatchRemoveFlags": {
			"ignore": [
				// the parser gives header values without a trailing line feed
				"App\\Api\\MetadataImporterMultipartApi::handle::392",
				// the Y-m-d round trip refuses a trailing line feed
				"App\\Utils\\Helper::check_date::651",
				// the D flag: mailparse drops a trailing line feed; the line's u flag mutant
				// is killed by MailLogTest's invalid UTF-8 case
				"App\\Models\\MailLog::mimeFromAddress::260",
				// the address is lowercased first; [^=]+ takes a trailing line feed either way
				"App\\Utils\\Helper::convertSRSAddress::456",
				"App\\Utils\\Helper::convertSRSAddress::468"
			]
		},
		"PublicVisibility": {
			// public, but only called inside its class (Eloquent calls accessors,
			// mutators and scopes from inside the model)
			"ignore": [
				"App\\Models\\MailLog::getMimeFromDecodedAttribute::200",
				"App\\Models\\MailLog::getVirusFromSymbolAttribute::190",
				"App\\Models\\MailLog::getMailRecipientsAttribute::315",
				"App\\Models\\MailLog::getRcptToAttribute::341",
				"App\\Models\\MailLog::getHeadersAttribute::436",
				"App\\Models\\MailLog::getSymbolsAttribute::446",
				"App\\Models\\MailLog::getFuzzyHashesAttribute::456",
				"App\\Models\\User::setDisableNotificationsAttribute::78",
				"App\\Models\\MapCombined::scopeForMap::89",
				"App\\Models\\MapCombined::scopeMailFromRcptTo::97",
				"App\\Models\\MapCombined::scopeMailFrom::105",
				"App\\Models\\MapCustom::scopeForMap::66",
				"App\\Configuration\\Config::loadAndInit::152",
				"App\\Utils\\Helper::checkForMap::259",
				"App\\Utils\\Helper::convertSRSAddress::450"
			]
		},
		"ReturnRemoval": {
			"ignore": [
				// a column the row was loaded without reads as null anyway
				"App\\Models\\MailLog::mailLogDataValue::407",
				// a non-IPv6 value falls through to the same $ip
				"App\\Core\\Auth\\LoginThrottle::keyFor::286",
				// a null count is below every limit: it falls through to the same false
				"App\\Core\\Auth\\LoginThrottle::registerFailure::114",
				// without a cache the call in the try throws, and its catch returns [] too
				"App\\Core\\Auth\\LoginThrottle::listBlocked::178",
				"App\\Core\\Auth\\LoginThrottle::listCounters::207",
				// listByPrefix() returns every key or throws: nothing is collected before the catch
				"App\\Core\\Auth\\LoginThrottle::listBlocked::192",
				"App\\Core\\Auth\\LoginThrottle::listCounters::228",
				// the Y-m-d round trip refuses it too
				"App\\Utils\\Helper::check_date::652",
				// 'unknown' fails IP::create() and returns true there
				"App\\Utils\\Helper::isLocalOrReservedIp::1221",
				// the function ends in return null too
				"App\\Utils\\Helper::getCountry::1202",
				// without a cache countByPrefix() on null throws, caught, and returns null too
				"App\\Utils\\Helper::count_dns_cache::1673",
				// an unknown action falls out of the switch to the same return "clean"
				"App\\Utils\\Helper::get_row_class::388",
				// nothing to embed: the HTML comes back as it is either way
				"App\\Inventory\\MailObject::embedImages::93",
				"App\\Inventory\\MailObject::embedImages::112",
				// inet_pton() fails on what FILTER_VALIDATE_IP refused, and the next check returns $value
				"App\\Inventory\\MapInventory::canonicalIpOrCidr::459",
				// without a database a later check returns as well
				"App\\Core\\Database\\MigrationStatus::warmCache::66",
				"App\\Core\\Database\\MigrationStatus::warmCache::70",
				// without a cache, the calls on it fail inside their try and the same lookup follows
				"App\\Utils\\Helper::my_gethostbyaddr::1532",
				"App\\Utils\\Helper::my_gethostbyname::1602"
			]
		},
		"SharedCaseRemoval": {
			// these cases fall to default; the line also holds the default's own
			// mutant, which testGetDelivery's 'unknown action' kills
			"ignore": ["App\\Utils\\Helper::getDelivery::398"]
		},
		"SpreadOneItem": {
			// one-key lists: [...$a][0] is $a
			"ignore": [
				"App\\Configuration\\EnvValidator::errors::90",
				"App\\Configuration\\EnvValidator::errors::131"
			]
		},
		"TrueValue": {
			"ignore": [
				// a column name is no numeric string: == matches as === does
				"App\\Utils\\FormHelper::getFilters::250",
				// custom maps come from the database; Integration covers them
				"App\\Inventory\\MapInventory::getMapConfigs::145",
				// without a database warmCache() returns before it could replace the loaded state
				"App\\Core\\Database\\MigrationStatus::loadPersistedState::211",
				"App\\Core\\Database\\MigrationStatus::loadPersistedState::218",
				// REMOTE_ADDR is an IP: no IP is a numeric string, so == matches as === does
				"App\\Api\\RqwatchApi::checkIpAcl::81",
				// filter, migration and status names are no numeric strings: == matches as === does
				"App\\Services\\VirusService::reportFilters::58",
				"App\\Services\\VirusService::markIgnoredFilters::69",
				"App\\Core\\Database\\MigrationStatus::setMigrationState::135",
				"App\\Core\\Database\\MigrationStatus::getMigrationState::150",
				"App\\Core\\Database\\MigrationStatus::mailLogVirusesWritable::327",
				"App\\Core\\Database\\MigrationStatus::mailLogFuzzyHitsMailsWritable::340"
			]
		},
		"UnwrapFinally": {
			// the catch takes every Throwable, so the handler is restored either way
			"ignore": ["App\\Models\\MailLog::mimeFromAddress::238"]
		},
		"UnwrapArrayDiffKey": {
			// $before is a closure's get_defined_vars(), which is always []
			"ignore": ["App\\Configuration\\Config::loadConfigFile::147"]
		},
		"UnwrapArrayFilter": {
			// an empty whitelist entry only matches an empty client IP, which is never throttled
			"ignore": ["App\\Core\\Auth\\LoginThrottle::__construct::80"]
		},
		"UnwrapStrToLower": {
			// mailparse gives the content type lowercased, without parameters
			"ignore": ["App\\Inventory\\MailObject::embedImages::100"]
		},
		"UnwrapTrim": {
			"ignore": [
				// the addresses are used past the database lookup
				"App\\Api\\ReleaseMailApi::handle::93",
				// mailparse gives the content type lowercased, without parameters
				"App\\Inventory\\MailObject::embedImages::100"
			]
		},
		"UnwrapArrayValues": {
			"ignore": [
				// in_array() does not need list keys
				"App\\Core\\Auth\\LoginThrottle::__construct::80",
				// only iterated
				"App\\Utils\\Helper::symbolMatches::247",
				// vsprintf() reads the values in order, whatever their keys
				"App\\Utils\\Helper::sqlWithBindings::1403"
			]
		},
		"UnwrapStrRepeat": {
			// one leading zero byte differs from 8 only in the reserved ::/8
			"ignore": ["App\\Core\\Auth\\LoginThrottle::keyFor::290"]
		},
		"UnwrapRtrim": {
			// netdns2 gives the name without its trailing dot: the rtrim() is a guard
			"ignore": ["App\\Utils\\Helper::lookupPtr::1586"]
		},
		"CatchBlockRemoval": {
			"ignore": [
				// their exceptions come from the database lookups; Integration's FuzzyApiTest covers them
				"App\\Api\\FuzzyMailApi::handle::80"
			]
		},
		"Identical": {
			"ignore": [
				// both lookups need the database, and fail alike without one; Integration covers them
				"App\\Api\\FuzzyMailApi::handle::81"
			]
		},
		"FunctionCallRemoval": {
			"ignore": [
				// UTF-8 is PHP's internal encoding by default already
				"App\\Api\\MetadataImporterMultipartApi::handle::267"
			]
		},
		"InstanceOf_": {
			// a name defined() on the enum is one of its cases: always a RouteName
			"ignore": ["App\\Twig\\RqwatchExtension::route::100"]
		}
	}
}
