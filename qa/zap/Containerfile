# Web server image for qa/zap-scan.sh: httpd and PHP-FPM from Remi's
# repository on Rocky Linux 9, installed as docs/INSTALL.md does. The code
# is not in the image: qa/zap-scan.sh mounts the copy at /var/www/html/rqwatch
# and runs qa/zap/web-start.sh from it. httpd's and PHP-FPM's own logs go to
# the container's output (podman logs).
ARG BASE_IMAGE=quay.io/rockylinux/rockylinux:9
FROM ${BASE_IMAGE}
ARG PHP_STREAM=remi-8.4
# qa/zap-scan.sh maps the invoking user to this uid (--userns=keep-id)
ARG RQWATCH_UID=1000
RUN dnf -y install dnf-plugins-core epel-release \
	&& dnf config-manager --set-enabled crb \
	&& dnf -y install https://rpms.remirepo.net/enterprise/remi-release-9.rpm \
	&& dnf -y module enable "php:${PHP_STREAM}" \
	&& dnf -y install httpd php-fpm php-cli php-mysqlnd php-pdo \
		php-pecl-mailparse php-mbstring php-xml \
		php-ldap php-pecl-redis6 php-gmp \
	&& dnf clean all \
	&& groupadd -g "${RQWATCH_UID}" rqwatch \
	&& useradd -u "${RQWATCH_UID}" -g rqwatch -M -d /var/www/html/rqwatch -s /sbin/nologin rqwatch \
	&& ln -sf /dev/stderr /var/log/httpd/error_log \
	&& ln -sf /dev/stdout /var/log/httpd/access_log \
	&& ln -sf /dev/stderr /var/log/php-fpm/error.log
# qa/zap-scan.sh passes a new UPDATE_STAMP on every run, so this layer, and
# only this one, is rebuilt: the packages are updated before each scan
ARG UPDATE_STAMP=none
RUN echo "dnf update: ${UPDATE_STAMP}" && dnf -y update && dnf clean all
