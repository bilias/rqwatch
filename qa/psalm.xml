<?xml version="1.0"?>
<psalm
	errorLevel="4"
	resolveFromConfigFile="false"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns="https://getpsalm.org/schema/config"
	xsi:schemaLocation="https://getpsalm.org/schema/config ../vendor/vimeo/psalm/config.xsd"
	findUnusedPsalmSuppress="true"
	findUnusedCode="false"
	allConstantsGlobal="true"
	runTaintAnalysis="false"
	sealAllProperties="false"
>
	<!-- Paths are relative to the project root: run from there (composer scripts do) -->
	<projectFiles>
		<directory name="app" />
		<directory name="bin" />
		<directory name="web" />
		<directory name="config" />
		<directory name="tests" />
		<directory name="qa" />
		<ignoreFiles>
			<directory name="vendor" />
		</ignoreFiles>
	</projectFiles>

	<stubs>
		<file name="qa/taint-stubs.phpstub"/>
	</stubs>

	<plugins>
		<pluginClass class="Qa\PsalmPlugin\Plugin"/>
	</plugins>

	<issueHandlers>
		<!-- the plugin works through Psalm's own providers, which Psalm marks @internal -->
		<InternalClass>
			<errorLevel type="suppress">
				<directory name="qa/PsalmPlugin"/>
			</errorLevel>
		</InternalClass>
		<InternalMethod>
			<errorLevel type="suppress">
				<directory name="qa/PsalmPlugin"/>
			</errorLevel>
		</InternalMethod>
		<InternalProperty>
			<errorLevel type="suppress">
				<directory name="qa/PsalmPlugin"/>
			</errorLevel>
		</InternalProperty>

		<RedundantCast errorLevel="suppress"/>

		<!-- Optional backends in Symfony RedisAdapter's return type; not installed -->
		<UndefinedClass>
			<errorLevel type="suppress">
				<referencedClass name="Relay\Relay"/>
				<referencedClass name="Relay\Cluster"/>
				<referencedClass name="Predis\ClientInterface"/>
			</errorLevel>
		</UndefinedClass>
	</issueHandlers>
</psalm>
