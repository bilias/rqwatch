includes:
	- ../vendor/larastan/larastan/extension.neon
	- ../vendor/yamadashy/phpstan-friendly-formatter/extension.neon

services:
	# select()/selectOne() rows are stdClass, as the Psalm plugin says
	-
		class: Qa\PHPStan\ConnectionRows
		tags:
			- phpstan.broker.dynamicMethodReturnTypeExtension

parameters:
	level: 8
	paths:
		- ../app
		- ../bin
		- ../web
		- ../config
		- ../tests
		- ../qa
	dynamicConstantNames:
		- CLI_MODE
		- API_MODE
		- WEB_MODE
		- ALLOW_DEGRADED_DB
	stubFiles:
		- phpstan-form.stub
	bootstrapFiles:
		- ../app/Configuration/AppConfig.php
		- phpstan-bootstrap.php
	# qa/taint-selftest/probes.php echoes raw values on purpose: each line is a
	# taint probe Psalm must flag, and qa/taint-selftest.php reads its
	# "// expect" markers at the line's end. PHPStan reports the echo from
	# level 9, so below that this entry matches nothing (reportUnmatched).
	ignoreErrors:
		-
			identifier: echo.nonString
			path: taint-selftest/probes.php
			reportUnmatched: false
	friendly:
		lineBefore: 0
		lineAfter: 0
		editorUrl: 'vim://%%file%%:%%line%%'

	# PHPStan paths are relative to this file (qa/); Larastan's own path
	# parameters are plain strings, so anchor them to the working directory.
	# Larastan: rqwatch is not a Laravel app, so give every path explicitly
	# (an empty one falls back to config_path()/database_path(), which don't exist here)
	configDirectories:
		- %currentWorkingDirectory%/config
	databaseMigrationsPath:
		- %currentWorkingDirectory%/contrib
	disableMigrationScan: true
	squashedMigrationsPath:
		- %currentWorkingDirectory%/contrib
