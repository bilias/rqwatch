includes:
	- ../vendor/larastan/larastan/extension.neon

parameters:
	level: 5
	paths:
		- ../app
		- ../bin
		- ../web
		- ../config
		- ../tests
	dynamicConstantNames:
		- CLI_MODE
		- API_MODE
		- WEB_MODE
		- ALLOW_DEGRADED_DB
	bootstrapFiles:
		- ../app/Configuration/AppConfig.php
		- phpstan-bootstrap.php

	# PHPStan paths are relative to this file (qa/); Larastan's own path
	# parameters are plain strings, so anchor them to the working directory.
	# Larastan: rqwatch is not a Laravel app, so give every path explicitly
	# (an empty one falls back to config_path()/database_path(), which don't exist here)
	configDirectories:
		- %currentWorkingDirectory%/config
	databaseMigrationsPath:
		- %currentWorkingDirectory%/contrib
	disableMigrationScan: true
	squashedMigrationsPath:
		- %currentWorkingDirectory%/contrib

	ignoreErrors:
		-
			identifier: return.type
			message: '#^Method App\\Services\\MapService::findMapEntry\(\) should return App\\Models\\MapCombined\|App\\Models\\MapCustom\|null but returns Illuminate\\Database\\Eloquent\\Model\|null\.$#'
			path: ../app/Services/MapService.php
			count: 1
		-
			message: '#^Call to an undefined method Traversable<mixed, mixed>::reverse\(\)\.$#'
			identifier: method.notFound
			path: ../app/Charts/ChartBuilder.php
			count: 2
		-
			message: '#^Call to an undefined method Twig\\Loader\\LoaderInterface::addPath\(\)\.$#'
			identifier: method.notFound
			path: ../app/Controllers/ViewController.php
			count: 1
		-
			message: '#^Call to an undefined method Symfony\\Component\\HttpFoundation\\Session\\SessionInterface::getFlashBag\(\)\.$#'
			identifier: method.notFound
			path: ../app/Core/Middleware/Authorization.php
			count: 1
		-
			message: '#^Call to an undefined method Symfony\\Component\\HttpFoundation\\Session\\SessionInterface::getFlashBag\(\)\.$#'
			identifier: method.notFound
			path: ../app/Core/Middleware/AuthMiddleware.php
			count: 1
		-
			message: '#^Property App\\Controllers\\Controller::\$(session|flashbag) \(.+\) does not accept Symfony\\Component\\HttpFoundation\\Session\\(SessionInterface|Flash\\FlashBagInterface)\.$#'
			identifier: assign.propertyType
			path: ../app/Controllers/Controller.php
			count: 2
		-
			identifier: assign.propertyType
			message: '#^Property App\\Models\\MailLog::\$release_date \(Carbon\\Carbon\|null\) does not accept string\.$#'
			path: ../app/Services/MailLogService.php
			count: 1
		-
			identifier: deadCode.unreachable
			path: ../app/Core/Database/Migrations/IdActionIndex.php
			count: 2
		-
			identifier: isset.offset
			path: ../app/Core/Database/Migrations/IdActionIndex.php
			count: 2
		-
			identifier: booleanNot.alwaysTrue
			path: ../app/Core/Database/Migrations/IdActionIndex.php
			count: 1
		-
			identifier: method.unused
			path: ../app/Core/Database/Migrations/IdActionIndex.php
			count: 1
		# defensive re-checks: editMapEntry() already rejects non-admin MapCustom
		-
			identifier: booleanAnd.leftAlwaysTrue
			message: '#^Left side of && is always true\.$#'
			path: ../app/Controllers/MapController.php
			count: 1
		-
			identifier: identical.alwaysTrue
			message: '#^Strict comparison using === between .MapCustom. and .MapCustom. will always evaluate to true\.$#'
			path: ../app/Controllers/MapController.php
			count: 1
		# defensive null check on map configs, which may come from the DB
		-
			identifier: identical.alwaysFalse
			message: '#^Strict comparison using === between .+ and null will always evaluate to false\.$#'
			path: ../app/Inventory/MapInventory.php
			count: 1
