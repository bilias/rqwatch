<?xml version="1.0" encoding="UTF-8"?>
<!-- paths are relative to this file (qa/) -->
<phpunit bootstrap="../vendor/autoload.php"
	colors="true"
	failOnWarning="true"
	failOnNotice="true"
	failOnDeprecation="true"
	failOnRisky="true">
	<testsuites>
		<!-- helpers on their own -->
		<testsuite name="helpers">
			<directory>../tests/Unit/Helpers</directory>
		</testsuite>
		<!-- route access levels and the access middlewares: phpunit option testsuite=routing runs them alone -->
		<testsuite name="routing">
			<directory>../tests/Unit/Routing</directory>
		</testsuite>
		<!-- authentication backends without their servers (LdapAuth attribute reading) -->
		<testsuite name="auth">
			<directory>../tests/Unit/Auth</directory>
		</testsuite>
		<!-- Twig filters and functions (RqwatchExtension) -->
		<testsuite name="twig">
			<directory>../tests/Unit/Twig</directory>
		</testsuite>
		<!-- Kernel boot decisions (which CLI commands run on an unmigrated database), RedisCache replies and the config cache -->
		<testsuite name="core">
			<directory>../tests/Unit/Core</directory>
		</testsuite>
		<!-- controller logic that needs no request (the rspamd stats block) -->
		<testsuite name="controllers">
			<directory>../tests/Unit/Controllers</directory>
		</testsuite>
		<!-- model accessors that need no database -->
		<testsuite name="models">
			<directory>../tests/Unit/Models</directory>
		</testsuite>
		<!-- chart objects (Chart) -->
		<testsuite name="charts">
			<directory>../tests/Unit/Charts</directory>
		</testsuite>
		<!-- the importer's metadata fields -->
		<testsuite name="api">
			<directory>../tests/Unit/Api</directory>
		</testsuite>
		<!-- parsed mail objects (MailObject) -->
		<testsuite name="inventory">
			<directory>../tests/Unit/Inventory</directory>
		</testsuite>
	</testsuites>
	<source>
		<include>
			<directory>../app</directory>
		</include>
	</source>
</phpunit>
