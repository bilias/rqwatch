{% extends 'base.html.twig' %}

{% block content %}
<div class="center-container">

<div class='active_filters wide'>
<span class='descr'>Active Filters</span>
<ul>
{% for filter in filters %}
 <li class='filtername'>{{ filter.filter }} {{ filter.choice }} "{{ filter.value }}"</li>
{% else %}
<li class='filtername'>No filters</li>
{% endfor %}
</ul>
</div>

<div class='quarantine wide'>

 <span class='descr'>Top {{ max_items }} {{ field|replace({'_': ' '})|upper }}
 {% if mode == 'stored' %}
  by Stored
 {% elseif mode == 'volume' %}
  by Volume
 {% elseif field == 'date' and mode == 'day' %}
  by Date
 {% else %}
  by Quantity
 {% endif %}
 </span>

 <div class="row caption">
   <div class="cell left">{{ field|replace({'_': ' '})|upper }}</div>
  {% if field == 'ip' %}
   <div class="cell left">Hostname</div>
  {% endif %}
   <div class="cell right"># Total</div>
   <div class="cell right"># Stored</div>
   <div class="cell right">Total size</div>
 </div>

<div class='quarantine_days'>
{% for log in logs %}
 {% set value = attribute(log, field) %}
 <div class="row">
  <div class='cell day'>
  {% if field in reportFields %}
	{% if is_admin %}
	<a href="{{ route('ADMIN_SEARCH_RESULTS') }}?{{ field }}={{ value|url_encode }}">
		{{ value }}
   </a>
	{% else %}
	<a href="{{ route('SEARCH_RESULTS') }}?{{ field }}={{ value|url_encode }}">
		{{ value }}
   </a>
	{% endif %}
  {% else %}
		{{ value }}
  {% endif %}
  </div>
 {% if field == 'ip' %}
  {% set host = value ? gethostbyaddr(value) %}
  <div class='cell day host'>{{ host != value ? host }}</div>
 {% endif %}
  <div class='cell right cnt'>{{ log.total|nf }}</div>
  <div class='cell right cnt'>{{ log.total_stored }}</div>
  <div class='cell right cnt'>{{ formatSizeUnits(log.total_size) }}</div>
 </div>
{% endfor %}
 <div class="row caption">
  <div class='cell day'>Total:</div>
 {% if field == 'ip' %}
  <div class='cell day host'></div>
 {% endif %}
  <div class='cell right cnt'>{{ sum.count|nf }}</div>
  <div class='cell right cnt'>{{ sum.stored|nf }}</div>
  <div class='cell right cnt'>{{ formatSizeUnits(sum.size) }}</div>
 </div>
 </div>
</div>
</div>

{% endblock %}
