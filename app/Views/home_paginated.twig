{% extends 'base.html.twig' %}
{% import 'macros/paginator.macro.twig' as ui %}

{% block content %}

{% include 'partials/colorcodes.html.twig' %}

{% if filters is defined %}
<div class="center-container">
<div class='active_filters'>
<span class='descr'>Active Filters</span>
<ul>
{% for filter in filters %}
 <li class='filtername'><span>{{ filter.filter }} {{ filter.choice }} "{% if filter.url ?? false %}<a href="{{ filter.url }}">{{ filter.value }}</a>{% else %}{{ filter.value }}{% endif %}"{% if filter.ignored ?? false %} (ignored){% endif %}</span></li>
{% else %}
<li class='filtername'>No filters</li>
{% endfor %}
</ul>
</div>
</div>
{% endif %}

<div class='pagtop'>
{{ ui.paginator(logs, WEB_BASE, queryParams) }}
</div>

{% include 'partials/mails.html.twig' %}

<div class='pagbottom'>
{{ ui.paginator(logs, WEB_BASE, queryParams) }}
</div>

{% endblock %}
