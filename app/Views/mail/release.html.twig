{% include 'mail/header.twig' %}

{# inline styles, because an attached message/rfc822 is rendered in the
   same document by some clients and its <style> would otherwise apply here #}
{% set base = 'background-color:#ffffff !important; color:#000000 !important;' %}

<div style="{{ base }}">
<h3 style="{{ base }}">The following mail has been released from quarantine storage<br/>
and attached to this mail.</h3>
<h4 style="{{ base }}">Please be very carefull before opening any attachment the original mail might have!</h4>
<table style="{{ base }}">
<tr><th scope="row" style="{{ base }} text-align:left;">Date:</th><td style="{{ base }}">{{ created_at }}</td></tr>
<tr><th scope="row" style="{{ base }} text-align:left;">From:</th><td style="{{ base }}">{{ mime_from }}</td></tr>
<tr><th scope="row" style="{{ base }} text-align:left;">To:</th><td style="{{ base }}">{{ rcpt_to }}</td></tr>
<tr><th scope="row" style="{{ base }} text-align:left;">Subject:</th><td style="{{ base }}">'{{ subject }}'</td></tr>
<tr><th scope="row" style="{{ base }} text-align:left;">Mail Queue ID:</th><td style="{{ base }}">{{ qid }}</td></tr>
<tr><th scope="row" style="{{ base }} text-align:left;">Message ID:</th><td style="{{ base }}">{{ message_id }}</td></tr>
<tr><th scope="row" style="{{ base }} text-align:left;">Spam Score:</th><td style="{{ base }}">{{ score }}</td></tr>
<tr><th scope="row" style="{{ base }} text-align:left;">Virus Detected:</th><td style="{{ base }}">{% if has_virus %}Yes {{ virus_name }}{% else %}No{% endif %}</td></tr>
<tr><th scope="row" style="{{ base }} text-align:left;">Action:</th><td style="{{ base }}">{{ action }}</td></tr>
</table>

<h4 style="{{ base }}">{{ signature | nl2br }}</h4>
</div>

{% include 'mail/footer.twig' %}
