{% include 'mail/header.twig' %}

{# inline styles, because an attached message/rfc822 is rendered in the
   same document by some clients and its <style> would otherwise apply here #}
{% set base = 'background-color:#ffffff !important; color:#000000 !important;' %}

<div style="{{ base }}">
<h3 style="{{ base }}">The following mail has been released from quarantine storage<br/>
and attached to this mail.</h3>
<h4 style="{{ base }}">Please be very carefull before opening any attachment the original mail might have!</h4>
<table style="{{ base }}">
<tr><td style="{{ base }}"><strong>Date</strong>:</td><td style="{{ base }}">{{ created_at }}</td></tr>
<tr><td style="{{ base }}"><strong>From</strong>:</td><td style="{{ base }}">{{ mime_from }}</td></tr>
<tr><td style="{{ base }}"><strong>To</strong>:</td><td style="{{ base }}">{{ rcpt_to }}</td></tr>
<tr><td style="{{ base }}"><strong>Subject</strong>:</td><td style="{{ base }}">'{{ subject }}'</td></tr>
<tr><td style="{{ base }}"><strong>Mail Queue ID</strong>:</td><td style="{{ base }}">{{ qid }}</td></tr>
<tr><td style="{{ base }}"><strong>Message ID</strong>:</td><td style="{{ base }}">{{ message_id }}</td></tr>
<tr><td style="{{ base }}"><strong>Spam Score</strong>:</td><td style="{{ base }}">{{ score }}</td></tr>
<tr><td style="{{ base }}"><strong>Virus Detected</strong>:</td><td style="{{ base }}">{% if has_virus %}Yes {{ virus_name }}{% else %}No{% endif %}</td></tr>
<tr><td style="{{ base }}"><strong>Action</strong>:</td><td style="{{ base }}">{{ action }}</td></tr>
</table>

<h4 style="{{ base }}">{{ signature | nl2br }}</h4>
</div>

{% include 'mail/footer.twig' %}
