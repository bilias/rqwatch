{% include 'mail/header.twig' %}

<h3>The following mail has been saved in our quarantine storage<br/>
because our system has detected it as being high scored spam or that it contains a virus.</h3>
<table>
<tr><th scope="row" style="text-align:left;">Date:</th><td>{{ created_at }}</td></tr>
<tr><th scope="row" style="text-align:left;">From:</th><td>{{ mime_from }}</td></tr>
<tr><th scope="row" style="text-align:left;">To:</th><td>{{ rcpt_to }}</td></tr>
<tr><th scope="row" style="text-align:left;">Subject:</th><td>'{{ subject }}'</td></tr>
<tr><th scope="row" style="text-align:left;">Mail Queue ID:</th><td>{{ qid }}</td></tr>
<tr><th scope="row" style="text-align:left;">Spam Score:</th><td>{{ score }}</td></tr>
<tr><th scope="row" style="text-align:left;">Virus Detected:</th><td>{% if has_virus %}Yes {{ virus_name }}{% else %}No{% endif %}</td></tr>
<tr><th scope="row" style="text-align:left;">Action:</th><td>{{ action }} ({{ getDelivery(action) }})</td></tr>
</table>

<p>
<a target='_blank' href='{{ detailurl }}'>Click here to view mail details and optionally release it from quarantine</a>.
{% if link_one_time %}<br/>This link can be used only once.{% endif %}
</p>
<p>
You can disable these mail notifications by visiting your Profile page in the link above. You can also set your personal whitelist/blacklist.
</p>
<h4>{{ signature | nl2br }}</h4>

{% include 'mail/footer.twig' %}
