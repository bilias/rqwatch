{% extends 'base.html.twig' %}

{% block content %}
<div class="center-container">

<div class='active_filters'>
<span class='descr'>Active Filters</span>
<ul>
{% for filter in filters %}
 <li class='filtername'>{{ filter.filter }} {{ filter.choice }} "{{ filter.value }}"</li>
{% else %}
<li class='filtername'>No filters: the last 7 days</li>
{% endfor %}
</ul>
</div>

<div class='current_mails descr'>
Top {{ limit }} Rspamd symbols by {{ sort == 'score' ? 'total score' : 'quantity' }},
in the newest {{ mails|nf }} mail{{ mails == 1 ? '' : 's' }} of the search{% if mails >= max_items %} (capped at {{ max_items|nf }}){% endif %}
<div id="inside_links">
<ul>
<li><a href='{{ route('ADMIN_SYMBOLS_REPORT') }}?{{ {sort: sort == 'score' ? null : 'score', info: informational ? 1 : null}|url_encode }}'>Sort by {{ sort == 'score' ? 'quantity' : 'total score' }}</a></li>
<li><a href='{{ route('ADMIN_SYMBOLS_REPORT') }}?{{ {sort: sort == 'score' ? 'score' : null, info: informational ? null : 1}|url_encode }}'>{{ informational ? 'Hide' : 'Show' }} informational symbols (score 0)</a></li>
<li><a href='{{ route('ADMIN_SEARCH') }}'>Search</a></li>
</ul>
</div>
</div>

<div class='aliases'>
<table border='0' align='center' cellpadding='5' cellspacing='1' class='mail rowhover'>
<thead><tr>
 <th>Symbol</th>
 <th>Mails</th>
 <th>No action</th>
 <th>Junk</th>
 <th>Rejected</th>
 <th>Avg score</th>
 <th>Total score</th>
</tr></thead>
<tbody>
{% for row in rows %}
  <tr class='clean'>
  <td class='left'><a href="{{ route('ADMIN_SEARCH_RESULTS') }}?symbols={{ ('"' ~ row.name ~ '"')|url_encode }}">{{ row.name }}</a></td>
  <td class='center'>{{ row.mails|nf }}</td>
  <td class='center'>{{ row.no_action|nf }}</td>
  <td class='center'>{{ row.junk|nf }}</td>
  <td class='center'>{{ row.rejected|nf }}</td>
  <td class='center'>{{ row.avg_score|nf(2) }}</td>
  <td class='center'>{{ row.total_score|nf(2) }}</td>
  </tr>
{% else %}
  <tr><td colspan='7' class='center'>No symbols</td></tr>
{% endfor %}
</tbody>
</table>
</div>

</div>
{% endblock %}
