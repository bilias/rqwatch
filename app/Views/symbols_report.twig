{% extends 'base.html.twig' %}

{% block content %}
<div class="center-container">

<div class='active_filters'>
<span class='descr'>Active Filters</span>
<ul>
{% for filter in filters %}
 <li class='filtername'>{{ filter.filter }} {{ filter.choice }} "{{ filter.value }}"</li>
{% else %}
<li class='filtername'>No filters: the last 7 days, since {{ since }}</li>
{% endfor %}
</ul>
</div>

<div class='current_mails descr'>
Top {{ limit }} {{ local ? 'local and mapped ' }}Rspamd symbols by {{ sort == 'score' ? 'average score' : 'quantity' }},
in the newest {{ mails|nf }} mail{{ mails == 1 ? '' : 's' }} of the search{% if mails >= max_items %} (capped at {{ max_items|nf }}){% endif %}
<div id="inside_links">
<ul>
{% set base = {local: local ? 1 : null, sort: sort == 'score' ? 'score' : null, info: informational ? 1 : null} %}
<li><a href='{{ route('ADMIN_SYMBOLS_REPORT') }}?{{ base|merge({sort: sort == 'score' ? null : 'score'})|url_encode }}'>Sort by {{ sort == 'score' ? 'quantity' : 'average score' }}</a></li>
<li><a href='{{ route('ADMIN_SYMBOLS_REPORT') }}?{{ base|merge({info: informational ? null : 1})|url_encode }}'>{{ informational ? 'Hide' : 'Show' }} informational symbols (score 0)</a></li>
<li><a href='{{ route('ADMIN_SEARCH') }}'>Search</a></li>
</ul>
</div>
</div>

<div class='aliases'>
<table border='0' align='center' cellpadding='5' cellspacing='1' class='mail rowhover'>
<thead><tr>
 <th>Symbol</th>
 <th>Mails</th>
{% for action in actions %}
 <th>{{ action != '' ? action|capitalize : '-' }}</th>
{% endfor %}
 <th>Avg score</th>
</tr></thead>
<tbody>
{% for row in rows %}
  <tr class='clean'>
{% set symbol = '"' ~ row.name ~ '"' %}
  <td class='left'><a href="{{ route('ADMIN_SEARCH_RESULTS') }}?{{ {symbols: symbol, since: since}|url_encode }}">{{ row.name }}</a></td>
  <td class='center'>{{ row.mails|nf }}</td>
{% for action in actions %}
{% set n = row.actions[action] ?? 0 %}
  <td class='center'>{% if n > 0 and action != '' %}<a href="{{ route('ADMIN_SEARCH_RESULTS') }}?{{ {symbols: symbol, action: action, since: since}|url_encode }}">{{ n|nf }}</a>{% else %}{{ n|nf }}{% endif %}</td>
{% endfor %}
  <td class='center'>{{ row.avg_score|nf(2) }}</td>
  </tr>
{% else %}
  <tr><td colspan='{{ 3 + actions|length }}' class='center'>No symbols</td></tr>
{% endfor %}
</tbody>
</table>
</div>

</div>
{% endblock %}
