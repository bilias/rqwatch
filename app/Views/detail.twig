{% extends 'base.html.twig' %}

{% block content %}
{% if error %}
{{ error }}
{% else %}
<div class="maildetail">
 <div class="row">
   <div class='info'>Date:</div>
   <div class='detail'>{{ log.created_at }}</div>
 </div>
{% if subject_privacy is same as(false) %}
 <div class="row">
   <div class='info'>Subject:</div>
   <div class='detail'>{{ log.subject|mark_homoglyphs }}</div>
 </div>
{% endif %}
 {% if is_admin %}
 <div class="row">
   <div class='info'>Server:</div>
   <div class='detail'>{{ log.server }}</div>
 </div>
 {% endif %}
 <div class="row">
   <div class='info'>Received from:</div>
   <div class='detail'>
{% if log.ip == 'unknown' %}
 {{ log.ip }}
{% elseif log.ip %}
  {{ log.ip }} ({{ gethostbyaddr(log.ip) }})
  {% if ip_country %}
   ({{ ip_country }})
  {% endif%}
  {% if map_configs['ip_whitelist']['add_url'] %}
   <br/><a class='whitelist' href='{{ map_configs['ip_whitelist']['add_url'] }}'>Add to '{{  map_configs['ip_whitelist']['description'] }}'</a>
  {% endif %}
  {% if map_configs['ip_blacklist']['add_url'] %}
   | <a class='blacklist' href='{{ map_configs['ip_blacklist']['add_url'] }}'>Add to '{{  map_configs['ip_blacklist']['description'] }}'</a>
  {% endif %}
{% endif %}
   </div>
 </div>
{% if relays %}
 <div class="row">
   <div class='info'>Mail Relays:</div>
   <div class='detail'>
{% for relay in relays %}
	{{ relay.ip }}
{% if relay.host %}
	({{ relay.host }})
{% endif %}
{% if relay.country %}
	({{ relay.country }})
{% endif %}
	<br/>
{% endfor %}
	</div>
 </div>
{% endif %}
 <div class="row">
   <div class='info'>Mail Queue ID:</div>
   <div class='detail'>{{ log.qid }}</div>
 </div>
 <div class="row">
   <div class='info'>Message ID:</div>
   <div class='detail'>{{ log.message_id }}</div>
 </div>
 <div class="row">
   <div class='info'>Mail From (original):</div>
   <div class='detail'>{{ log.mail_from }}
	{% if is_admin %}
    {% if map_configs['mail_from_whitelist']['add_url'] %}
	  <br/><a class='whitelist' href='{{ map_configs['mail_from_whitelist']['add_url'] }}'>Add to '{{ map_configs['mail_from_whitelist']['description'] }}'</a>
	 {% endif %}
    {% if map_configs['mail_from_blacklist']['add_url'] %}
	  | <a class='blacklist' href='{{ map_configs['mail_from_blacklist']['add_url'] }}'>Add to '{{ map_configs['mail_from_blacklist']['description'] }}'</a>
	 {% endif %}
	{% endif %}
   {% if map_configs['mail_from_rcpt_to_whitelist']['add_url'] %}
	 | <a class='whitelist' href='{{ map_configs['mail_from_rcpt_to_whitelist']['add_url'] }}'>Add to '{{ map_configs['mail_from_rcpt_to_whitelist']['description'] }}'</a>
	{% endif %}
   {% if map_configs['mail_from_rcpt_to_blacklist']['add_url'] %}
	 | <a class='blacklist' href='{{ map_configs['mail_from_rcpt_to_blacklist']['add_url'] }}'>Add to '{{ map_configs['mail_from_rcpt_to_blacklist']['description'] }}'</a>
	{% endif %}
	</div>
 </div>
 <div class="row">
   <div class='info'>Mail From (decoded):</div>
   <div class='detail'>{{ decodeEmail(log.mail_from) }}</div>
 </div>
 <div class="row">
   <div class='info'>MIME From:</div>
   <div class='detail'>{{ log.mime_from|mark_homoglyphs }}
	{% if is_admin %}
    {% if map_configs['mime_from_whitelist']['add_url'] %}
	  <br/><a class='whitelist' href='{{ map_configs['mime_from_whitelist']['add_url'] }}'>Add to '{{ map_configs['mime_from_whitelist']['description'] }}'</a>
	 {% endif %}
    {% if map_configs['mime_from_blacklist']['add_url'] %}
	  | <a class='blacklist' href='{{ map_configs['mime_from_blacklist']['add_url'] }}'>Add to '{{ map_configs['mime_from_blacklist']['description'] }}'</a>
	 {% endif %}
	{% endif %}
   {% if map_configs['mime_from_rcpt_to_whitelist']['add_url'] %}
	 | <a class='whitelist' href='{{ map_configs['mime_from_rcpt_to_whitelist']['add_url'] }}'>Add to '{{ map_configs['mime_from_rcpt_to_whitelist']['description'] }}'</a>
	{% endif %}
   {% if map_configs['mime_from_rcpt_to_blacklist']['add_url'] %}
	 | <a class='blacklist' href='{{ map_configs['mime_from_rcpt_to_blacklist']['add_url'] }}'>Add to '{{ map_configs['mime_from_rcpt_to_blacklist']['description'] }}'</a>
	{% endif %}
   </div>
 </div>
 <div class="row">
   <div class='info'>MIME To:</div>
   <div class='detail'>{{ log.mime_to }}</div>
 </div>
 <div class="row">
   <div class='info'>RCPT To:</div>
   <div class='detail'>{{ log.mail_recipients }}</div>
 </div>
 <div class="row">
   <div class='info'>Action taken:</div>
   <div class='detail'><span class='{{ get_row_class(log.action) }}'>{{ log.action }}</span>
	({{ getDelivery(log.action) }})</div>
 </div>
 {% set row_class = get_row_class(log.action, log.symbols) %}
 {% if row_class == 'whitelist' %}
 <div class="row">
   <div class='info'>Whitelisted:</div>
   <div class='detail'><span class='{{ row_class }}'>Yes</span></div>
 </div>
 {% endif %}
 {% if row_class == 'blacklist' %}
 <div class="row">
   <div class='info'>Blacklisted:</div>
   <div class='detail'><span class='{{ row_class }}'>Yes</span></div>
 </div>
 {% endif %}
 <div class="row">
   <div class='info'>Score:</div>
   <div class='detail'>{{ log.score }}</div>
 </div>
 <div class="row">
   <div class='info'>Size:</div>
   <div class='detail'>{{ formatSizeUnits(log.size) }}</div>
 </div>
 <div class="row">
   <div class='info'>Stored:</div>
   <div class='detail'>
{% if not log.mail_stored %}
No 
{% else %}
<strong>Yes</strong>:
{% endif %} {# log.mail_stored #}
{% if log.mail_location %}
 {% if is_admin %}
	{% set mailurl = route('ADMIN_SHOWMAIL', { id: log.id }) %}
 {% else %}
	{% set mailurl = route('SHOWMAIL', { id: log.id }) %}
 {% endif %}
	{# open in new window #}
	{# <a class='stored' href='{{ mailurl }}' onclick="window.open('{{ mailurl|e('js') }}', 'newwindow', 'width=1024,height=768'); return false;"> #}
	{% if log.mail_stored %}
		<a class='stored' href='{{ mailurl }}' target='_blank'>
			{% if is_admin %}
				{{ log.mail_location }}
			{% elseif stripped_mail_location %}
				{{ stripped_mail_location }}
			{% else %}
				Quarantined mail
			{% endif %}</a> {# is_admin #}
			<span class='detail'>(Click to see mail and possible attachments)</span>
	{% else %} {# not log.mail_stored #}
		{% if is_admin %}
			{{ log.mail_location }}
		{% elseif stripped_mail_location %}
			{{ stripped_mail_location }}
		{% else %}
			Quarantined mail
		{% endif %} {# is_admin #}
		<span class='detail'>(Has been purged from quarantine)</span>
	{% endif %} {# log.mail_stored #}
{% endif %} {# log.mail_location #}
  </div>
 </div>
{% include 'partials/fuzzy_row.html.twig' %}
 <div class="row">
   <div class='info'>Notified:</div>
   <div class='detail'>
{% if log.notified %}
<strong>Yes</strong>: {{ log.notify_date }}
{% elseif log.notified is not null and not log.notification_pending %}
No
{% elseif blacklisted %}
No (Blacklisted)
{% elseif virus_skip is not null %}
No (Virus{% if is_admin %} skip map: {{ virus_skip }}{% endif %})
{% elseif log.score > NOTIFICATION_SCORE %}
No (Disabled due to high score)
{% elseif notifications_disabled %}
No (Disabled for all recipients)
{% elseif log.notified is null %}
No (Disabled)
{% elseif notified_expired %}
No (Expired)
{% else %}
Pending
{% endif %}</div>
 </div>
{% if is_admin and admin_notifications %}
 <div class="row">
   <div class='info'>Admin notified:</div>
   <div class='detail'>
{% if log.admin_notified %}
<strong>Yes</strong>: {{ log.admin_notify_date }}
{% elseif not admin_notifications_enabled or (log.admin_notified is null and log.admin_notify_date is null) %}
No
{% elseif blacklisted %}
No (Blacklisted)
{% elseif virus_skip is not null %}
No (Virus skip map: {{ virus_skip }})
{% elseif log.score > NOTIFICATION_SCORE %}
No (Disabled due to high score)
{% elseif log.admin_notified is null %}
No
{% elseif admin_notified_expired %}
No (Expired)
{% else %}
Pending
{% endif %}</div>
 </div>
{% endif %}
 <div class="row">
   <div class='info'>Released:</div>
   <div class='detail'>
{% if log.released %}
<strong>Yes</strong>: {{ log.release_date }}
{% else %}
No
{% endif %}</div>
 </div>
 <div class="row">
   <div class='info'>Has Virus:</div>
   <div class='detail'>
{% if log.has_virus %}
<strong>Yes</strong>:
<span class='virus'>{{ virus_found }}</span>
{% else %}
No
{% endif %}
   </div>
 </div>
 <div class="row">
   <div class='info'>Rspamd Symbols:</div>
   <div class='detail'>
{% if is_admin %}
	 <button data-toggle="symbols" data-toggle-label>Hide</button>
	 <div id='symbols'>
{% else %}
	 <button data-toggle="symbols" data-toggle-label>Show</button>
	 <div id='symbols' hidden>
{% endif %}
{% for symbol in symbols %}
<span class='{{ get_symbol_class(symbol) }}'>{{ symbol }}</span>
{%- for link in symbol_links[symbol|split(':')|first] ?? [] %} <a href="{{ link.url }}">[{{ link.label }}]</a>{% endfor %}<br/>
{% endfor %}
    </div>
   </div>
 </div>
 <div class="row">
   <div class='info'>Mail Headers:</div>
   <div class='detail'>
{% if is_admin %}
    <button data-toggle="mailheaders" data-toggle-label>Hide</button>
	 <div id='mailheaders'>
{% else %}
    <button data-toggle="mailheaders" data-toggle-label>Show</button>
	 <div id='mailheaders' hidden>
{% endif %}
	 <pre>{{ log.headers }}</pre>
	 </div>
	</div>
 </div>
 {% include 'partials/mail_release_form.html.twig' %}
</div>
{% endif %}

{% endblock %}
