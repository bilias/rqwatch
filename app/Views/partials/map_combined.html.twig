{% import 'macros/paginator.macro.twig' as ui %}
<section>

<div class='pagtop'>
{{ ui.paginator(map_entries, WEB_BASE) }}
</div>

<div class="center-container">

<div class='mapform descr'>
{% if is_admin %}
Basic/Combined Map: <a target='_blank' href="{{ maps_url_base ~ map ~ '.txt' }}">{{ mapdescr }}</a><br/>
{% else %}
Basic/Combined Map: {{ mapdescr }}<br/>
{% endif %}
{{ totalRecords|nf }} {{ idle ? 'idle ' }}entries
{% if last_activity %}
| Updated {{ last_activity }}
{% endif %}
{% if totalRecords > items_per_page %}
<br/>Displaying {{ items_per_page }}/page
{% endif %}
<div id="inside_links">
<ul>
{% if idle or entry_filter %}
<li><a href='{{ route(is_admin ? 'ADMIN_MAP_SHOW' : 'MAP_SHOW', { map: map }) }}'>Show all entries</a></li>
{% elseif entry_hits is not null %}
<li><a href='{{ route(is_admin ? 'ADMIN_MAP_SHOW' : 'MAP_SHOW', { map: map }) }}?idle=1'>Show idle entries (no hits in {{ hits_days }} days)</a></li>
{% endif %}
{% if is_admin %}
<li><a href='{{ route('ADMIN_MAP_ADD_ENTRY', { map: map} ) }}'>Add New entry</a></li>
<li><a href='{{ route('ADMIN_MAP_DEL_ALL_ENTRIES', { map: map, _token: csrf_token('map_delall') } ) }}' onclick="return confirm('Are you sure you want to delete all entries from map: \'{{ mapdescr|e('js') }}\'?')">Delete All Entries</a></li>
{% else %}
<li><a href='{{ route('MAP_ADD_ENTRY', { map: map} ) }}'>Add New entry</a></li>
<li><a href='{{ route('MAP_DEL_ALL_ENTRIES', { map: map, _token: csrf_token('map_delall') } ) }}' onclick="return confirm('Are you sure you want to delete all entries from map: \'{{ mapdescr|e('js') }}\'?')">Delete All Entries</a></li>
{% endif %}
</ul>
</div>
</div>

{% if map_entries is not empty %}

{% if is_admin and mapsearchform %}
<div class="mapsearchform">
{% include 'partials/map_search.html.twig' %}
</div>
{% endif %}

<div class='mapform'>
<table border='0' align='center' cellpadding='5' cellspacing='1' class='mail rowhover'>
<thead><tr>
 {% for field in fields %}
 <th class='email'>{{ descriptions[loop.index0] ?? field }}</th>
 {% endfor %}
 <th class='email'>Updated</th>
{% if entry_hits is not null %}
 <th class='email'>Hits ({{ hits_days }} days)</th>
 <th class='email'>Last hit</th>
{% endif %}
 <th class='email'>Creator</th>
 <th class='email'>Enable/Disable</th>
 <th class='email'>Delete</th>
 <th class='email'>Edit</th>
</tr></thead>

<tbody>
    {% for entry in map_entries %}
		{% set parts = [] %}
      <tr class='clean'>
        {% for field in fields %}
          <td class='center {{ entry.disabled ? 'disabled' }}'>{{ attribute(entry, field) }}</td>
			 {% set parts = parts|merge([descriptions[loop.index0] ~ ': ' ~ attribute(entry, field)]) %}
        {% endfor %}
			 <td class='center'>{{ entry.updated_at }}</td>
{% if entry_hits is not null %}
{% set hit = entry_hits[entry.id] ?? null %}
			 <td class='center'>{% if hit and hit.hits > 0 %}<a href="{{ route(is_admin ? 'ADMIN_MAP_HITS_MAILS' : 'MAP_HITS_MAILS') }}?map={{ map|url_encode }}&amp;entry={{ entry.id }}&amp;days={{ hits_days }}">{{ hit.hits|nf }}</a>{% else %}0{% endif %}</td>
			 <td class='center'>{{ hit.last ?? 'never' }}</td>
{% endif %}
			 <td class='center'>{{ entry.map_username }}</td>

		  {% set entry_str = parts|join(', ') %}
       <td class='center'>
         {% if is_admin %}
            <a href="{{ route('ADMIN_MAP_TOGGLE_ENTRY', { map: map, id: entry.id, _token: csrf_token('map_toggle') }) }}">
            {{ entry.disabled ? 'Enable' : 'Disable' }}</a>
         {% elseif entry.user_can_delete %}
            <a href="{{ route('MAP_TOGGLE_ENTRY', { map: map, id: entry.id, _token: csrf_token('map_toggle') }) }}">
            {{ entry.disabled ? 'Enable' : 'Disable' }}</a>
         {% else %}
            -
         {% endif %}
         </td>

{% if is_admin %}
          <td class='center'><a href="{{ route('ADMIN_MAP_DEL_ENTRY', { map: map, id: entry.id, _token: csrf_token('map_del') }) }}" onclick="return confirm('Are you sure you want to delete entry:\n\'{{ entry_str|e('js') }}\'\nfrom Map:\n\'{{ mapdescr|e('js') }}\'?')">Delete</a></td>
          <td class='center'><a href="{{ route('ADMIN_MAP_EDIT_ENTRY', { map: map, id: entry.id }) }}">Edit</a></td>
{% elseif entry.user_can_delete %}
          <td class='center'><a href="{{ route('MAP_DEL_ENTRY', { map: map, id: entry.id, _token: csrf_token('map_del') }) }}" onclick="return confirm('Are you sure you want to delete entry:\n\'{{ entry_str|e('js') }}\'\nfrom Map:\n\'{{ mapdescr|e('js') }}\'?')">Delete</a></td>
          <td class='center'><a href="{{ route('MAP_EDIT_ENTRY', { map: map, id: entry.id }) }}">Edit</a></td>
  {% else %}
			<td class='center'>-</td>
			<td class='center'>-</td>
{% endif %}
      </tr>
    {% endfor %}
</tbody>

</table>
</div>

{% else %}
    <p>No entries found</p>
{% endif %}

</div>
</section>
