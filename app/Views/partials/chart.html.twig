<div class="header-chart-wrap">
	<div class="header-chart">
		<canvas id="{{ id }}"></canvas>
	</div>
	{% if chart.getAttributes().note is defined %}
	<span class="center help-text2">{{ chart.getAttributes().note|nl2br }}</span>
	{% endif %}
</div>

<script>
{
	const cfg = {
		type: {{ chart.getType()|js_json }},
		data: {{ chart.getData()|js_json }},
		options: {{ chart.getOptions()|js_json }}
	};
	const linkAt = (els, c) => els.length ? (c.data.datasets[els[0].datasetIndex].links || [])[els[0].index] : null;
	cfg.options.onClick = (e, els, c) => { const l = linkAt(els, c); if (l) window.location.href = l; };
	cfg.options.onHover = (e, els, c) => { e.native.target.style.cursor = linkAt(els, c) ? 'pointer' : 'default'; };
	new Chart(document.getElementById({{ id|js_json }}), cfg);
}
</script>
