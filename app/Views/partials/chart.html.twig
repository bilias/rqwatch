<div class="header-chart-wrap">
	<div class="header-chart">
		<canvas id="{{ id }}" data-chart="{{ id }}-config"></canvas>
	</div>
	{% if chart.getAttributes().note is defined %}
	<span class="center help-text2">{{ chart.getAttributes().note|nl2br }}</span>
	{% endif %}
</div>

{# drawn by web/js/rqwatch.js; JSON data, not a script (js_json escapes
   < and >, so no value can close the element) #}
<script type="application/json" id="{{ id }}-config">{{ { type: chart.getType(), data: chart.getData(), options: chart.getOptions() }|js_json }}</script>
