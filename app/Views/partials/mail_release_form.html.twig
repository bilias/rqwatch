 {% if mailreleaseform %}
<div class='releaseform'>
{% if mailreleaseform_disabled %}
 <div class="row">
  <div class='info'>Release mail from quarantine</div>
  <div class='detail'>
{% if is_admin %}
<span style="color: red;">Release is disabled on this node: MAILER_DSN or MAILER_FROM is not set in .env</span>
{% else %}
Mail cannot be released. Contact administrator
{% endif %}
  </div>
 </div>
 </div>
{% else %}
 {{ form_start(mailreleaseform) }}

 <div class="row">
  <div class='info'>Release mail from quarantine</div>
  <div class='detail'>{{ form_widget(mailreleaseform.release, {
    'id': 'release_checkbox'
	 }) }}
  to original recipient: {{ form_widget(mailreleaseform.email) }}
  {{ form_errors(mailreleaseform.release) }}</div>
  <div class='info'>&nbsp;</div>
  <div class='detail'>{{ form_widget(mailreleaseform.release_alt, {
	 'id': 'release_alt_checkbox'
	 }) }}
  to alternate recipient(s): {{ form_widget(mailreleaseform.email_alt, {
    'id': 'release_alt_value'
	 }) }}
  {{ form_errors(mailreleaseform.release_alt) }}
  {{ form_errors(mailreleaseform.email_alt) }}</div>
  <div class='info'>&nbsp;</div>
  <div class='detail'>{{ form_widget(mailreleaseform.submit, {
    'id': 'submit_button'
	 }) }}
  </div>
 </div>

 {{ form_end(mailreleaseform) }}
 </div>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const release = document.getElementById('release_checkbox');
    const releaseAlt = document.getElementById('release_alt_checkbox');
    const releaseAltValue = document.getElementById('release_alt_value');
    const submitBtn = document.getElementById('submit_button');

    function toggleSubmit() {
        const altHasValue = releaseAltValue.value && releaseAltValue.value.trim() !== '';

        if (release.checked || (releaseAlt.checked && altHasValue)) {
            submitBtn.disabled = false;
        } else {
            submitBtn.disabled = true;
        }
    }

    // Run once on load
    toggleSubmit();

    // Watch for changes
    release.addEventListener('change', toggleSubmit);
    releaseAlt.addEventListener('change', toggleSubmit);
    releaseAltValue.addEventListener('input', toggleSubmit);
});
</script>
{% endif %}
 {% endif %}
