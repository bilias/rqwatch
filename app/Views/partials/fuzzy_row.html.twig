{# admin row: fuzzy learning state and actions; the fuzzy_* variables come from MailLogController::fuzzyView() #}
{% if fuzzy_enabled %}
 <div class="row">
   <div class='info'>Fuzzy:</div>
   <div class='detail'>
{% if fuzzy %}
{% set f = fuzzy_flags[fuzzy.flag] ?? null %}
<strong>Learned</strong> as {{ f ? f.label : 'flag ' ~ fuzzy.flag }}{% if f and f.symbol %} ({{ f.symbol }}){% endif %}, weight {{ fuzzy.weight }}: {{ fuzzy.created_at }} by {{ fuzzy.learned_by }}
<a href="{{ route('ADMIN_FUZZY_UNLEARN', { id: fuzzy.id, _token: csrf_token('fuzzy_unlearn') }) }}" data-confirm="Remove this mail from the fuzzy storage?"><button>Unlearn</button></a>
{% if fuzzy_hits %}
<br>Hits: {% if fuzzy.hits > 0 %}{% if fuzzy_hit_mails %}<a href="{{ route('ADMIN_FUZZY_HITS', { id: fuzzy.id }) }}">{{ fuzzy.hits }}</a>{% else %}{{ fuzzy.hits }}{% endif %}, last {{ fuzzy.last_hit_at }}{% else %}none yet{% endif %}
{% endif %}
{% if fuzzy_shared %}
<br>Shared with: {% for o in fuzzy_shared %}{% if o.mail_log_id %}<a href="{{ route('ADMIN_DETAIL', { type: 'id', value: o.mail_log_id }) }}">{{ o.qid }}</a>{% else %}{{ o.qid }} (purged){% endif %}{% if o.flag != fuzzy.flag %} ({{ fuzzy_flags[o.flag].label ?? ('flag ' ~ o.flag) }}){% endif %}{% if not loop.last %}, {% endif %}{% endfor %}
{% endif %}
{% if fuzzy_boostable and f %}
<form class="fuzzy-learn" method="get" action="{{ route('ADMIN_FUZZY_BOOST', { id: fuzzy.id }) }}" data-confirm="Add this weight to the learned mail?">
<input type="hidden" name="_token" value="{{ csrf_token('fuzzy_boost') }}">
<label for="fuzzy-boost-weight" class="sr-only">Weight to add</label>
<input type="number" id="fuzzy-boost-weight" name="weight" value="{{ min(f.weight, 65535 - fuzzy.weight) }}" min="1" max="{{ 65535 - fuzzy.weight }}" required title="Weight to add">
<button type="submit">Add weight</button>
</form>
{% endif %}
{% elseif fuzzy_learnable %}
No
{% for flag, f in fuzzy_flags %}
<form class="fuzzy-learn" method="get" action="{{ route('ADMIN_FUZZY_LEARN', { id: log.id, flag: flag }) }}" data-confirm="Learn this mail as {{ f.label|e('html_attr') }}?">
<input type="hidden" name="_token" value="{{ csrf_token('fuzzy_learn') }}">
<label for="fuzzy-learn-weight-{{ flag }}" class="sr-only">Weight</label>
<input type="number" id="fuzzy-learn-weight-{{ flag }}" name="weight" value="{{ f.weight }}" min="1" max="65535" required title="Weight">
<button type="submit">Learn as {{ f.label }}</button>
</form>
{% endfor %}
{% else %}
No
{% endif %}
{% if fuzzy_matched %}
<br>Matched learned: {% for m in fuzzy_matched %}{% if m.mail_log_id %}<a href="{{ route('ADMIN_DETAIL', { type: 'id', value: m.mail_log_id }) }}">{{ m.qid }}</a>{% else %}{{ m.qid }} (purged){% endif %} ({{ fuzzy_flags[m.flag].label ?? ('flag ' ~ m.flag) }}){% if not loop.last %}, {% endif %}{% endfor %}
{% endif %}</div>
 </div>
{% endif %}
