{
    "name": "bilias/rqwatch",
    "description": "Rqwatch is a quarantine and map management system for Rspamd",
	 "keywords": ["rspamd","antispam"],
	 "homepage": "https://github.com/bilias/rqwatch",
	 "license": "MPL-2.0",
	 "authors": [
		{
			"name": "Giannis Kapetanakis",
			"role": "Developer"
		}
	],
    "type": "project",
    "config": {
	     "platform": {
		      "php": "8.3.0"
		  }
	 },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "classmap": [
            "app/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.3",
        "ext-mysqlnd": "*",
        "ext-pdo": "*",
        "ext-ldap": "*",
        "ext-redis": "*",
        "ext-mbstring": "*",
        "ext-mailparse": "*",
        "ext-iconv": "*",
        "php-mime-mail-parser/php-mime-mail-parser": "^10.0",
        "vlucas/phpdotenv": "^5.6",
        "monolog/monolog": "^3.9",
        "illuminate/database": "^12.19",
        "illuminate/pagination": "^12.19",
        "twig/twig": "^3.21",
        "symfony/routing": "^7.3",
        "symfony/http-foundation": "^7.3",
        "symfony/http-kernel": "^7.3",
        "symfony/form": "^7.3",
        "symfony/security-csrf": "^7.3",
        "symfony/validator": "^7.3",
        "symfony/twig-bridge": "^7.3",
        "symfony/translation": "^7.3",
        "symfony/config": "^7.3",
        "symfony/password-hasher": "^7.3",
        "symfony/expression-language": "^7.3",
        "symfony/mailer": "^7.3",
        "symfony/http-client": "^7.3",
        "symfony/console": "^7.3",
        "symfony/lock": "^7.3",
        "symfony/cache": "^7.3",
        "rlanvin/php-ip": "^3.0",
        "maxmind-db/reader": "^1.12.1",
        "jumbojett/openid-connect-php": "^1.0",
        "mikepultz/netdns2": "^2.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.3",
        "larastan/larastan": "^3.13",
        "vimeo/psalm": "^6.5",
        "phpunit/phpunit": "^12"
    },
   "scripts": {
      "phpstan": "phpstan analyse -c qa/phpstan.neon --memory-limit=512M",
      "psalm": "psalm -c qa/psalm.xml --no-progress",
      "psalm-taint": "sh qa/psalm-taint.sh",
      "test-access": "phpunit -c qa/phpunit-access.xml",
      "test-scoping": "bash qa/scoping-tests.sh",
      "test": [
         "@test-access",
         "@test-scoping"
      ],
      "opengrep": "sh qa/opengrep.sh",
      "taint-stubs": "sh qa/taint-stubs.sh",
      "post-update-cmd": "@taint-stubs",
      "analyse": [
         "@phpstan",
         "@psalm"
      ],
      "analyze": "@analyse",
      "check": [
         "@composer validate --no-check-publish",
         "@composer audit --locked --abandoned=report",
         "@test-access",
         "@analyse",
         "@psalm-taint",
         "@opengrep",
         "@test-scoping"
      ]
   },
   "scripts-descriptions": {
      "phpstan": "PHPStan with Larastan (qa/phpstan.neon)",
      "psalm": "Psalm type checks (qa/psalm.xml)",
      "psalm-taint": "Psalm taint analysis; regenerates the vendor taint stub first",
      "test-access": "Access control: route access levels and middleware (no database)",
      "test-scoping": "Data scoping: users reach only their own data (throwaway MariaDB via Podman)",
      "test": "Both security test suites: test-access, then test-scoping",
      "opengrep": "Opengrep with the rqwatch and pinned community rules",
      "taint-stubs": "Regenerate qa/taint-stubs.phpstub from vendor",
      "analyse": "PHPStan and Psalm",
      "analyze": "Alias of analyse",
      "check": "Everything CI runs, cheapest first; stops at the first failure"
   }
}
